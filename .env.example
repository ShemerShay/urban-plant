# Copy to .env.local and fill in (or run: npm run setup:env)

# Admin area (middleware-protected routes)
ADMIN_PASSWORD=

# Gmail (order confirmation email via Nodemailer; server-only — never NEXT_PUBLIC_)
GMAIL_USER=
# Google Account → App passwords (not your normal Gmail password)
GMAIL_APP_PASSWORD=

# Optional: override plant page WhatsApp (972… or Israeli 05XXXXXXXX). Default in code: 054-660-5603.
NEXT_PUBLIC_WHATSAPP_PHONE=
# Optional: WhatsApp click-to-chat base (default https://wa.me)
NEXT_PUBLIC_WHATSAPP_CHAT_BASE=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional PostHog UI host (defaults to POSTHOG_HOST when unset)
NEXT_PUBLIC_POSTHOG_UI_HOST=

# Cardcom payment gateway (server-only — never NEXT_PUBLIC_)
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
# Cardcom official TEST ApiName (terminal 1000 only — admin Cardcom test path)
CARDCOM_TEST_API_NAME=
# Required for test Documents (CreateDocument / PDF). Do not fall back to production password.
CARDCOM_TEST_API_PASSWORD=
# Public HTTPS site origin for Cardcom Success/Failed/WebHook URLs (no trailing slash).
# Example: https://your-site.netlify.app — never localhost.
APP_ORIGIN=

# Shared secret for Netlify scheduled hold cleanup → POST /api/cron/expire-payment-holds
# Generate a long random string; set the same value in Netlify Environment Variables.
CRON_SECRET=

# Neon Postgres (from Neon console or: neonctl connection-string --pooled)
DATABASE_URL=
# Plant image uploads (admin) require: npm run db:migrate:plant-images
# If you see column "pos_name" does not exist, run: npm run db:migrate:pos-name
# After pulling POS spot UUID/pocket changes, run:
#   npm run db:migrate:pos-uuid-pocket
# If events migration fails on uuid cast, also run:
#   npm run db:migrate:events-pos-spot-uuid
