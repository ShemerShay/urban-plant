# Copy to .env.local and fill in (or run: npm run setup:env)

# Admin area (middleware-protected routes)
ADMIN_PASSWORD=

# Resend (order confirmation email)
RESEND_API_KEY=
# Verified sender in Resend, e.g. Urban Plant <orders@yourdomain.com>
RESEND_FROM=

# Optional: override plant page WhatsApp (972… or Israeli 05XXXXXXXX). Default in code: 054-660-5603.
NEXT_PUBLIC_WHATSAPP_PHONE=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Neon Postgres (from Neon console or: neonctl connection-string --pooled)
DATABASE_URL=
# If you see column "pos_name" does not exist, run: npm run db:migrate:pos-name
# After pulling POS spot UUID/pocket changes, run:
#   npm run db:migrate:pos-uuid-pocket
# If events migration fails on uuid cast, also run:
#   npm run db:migrate:events-pos-spot-uuid
